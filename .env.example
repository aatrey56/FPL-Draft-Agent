# ─────────────────────────────────────────────────────────────────────────────
# FPL Draft Co-Pilot — environment reference
# Copy to .env at the repo root. Both Go binaries and the Python CLIs load it
# automatically (a real exported environment variable always wins).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core: these three are all you need ───────────────────────────────────────

# Your FPL Draft league id — in the URL on draft.premierleague.com
# (e.g. /league/12345/... -> LEAGUE_ID=12345).
LEAGUE_ID=your-league-id

# Your entry (team) id — in the URL when viewing your team
# (e.g. /entry/67890/... -> ENTRY_ID=67890).
ENTRY_ID=your-entry-id

# A password YOU invent (nobody issues it) so only your own Claude clients can
# call the MCP server. Generate one:  openssl rand -hex 16
FPL_MCP_API_KEY=your-random-secret

# ── Legacy chat stack only (deprecated — safe to omit entirely) ──────────────
# The FastAPI/OpenAI backend (server.py/agent.py/llm.py/scheduler.py) is kept
# compiling but is not developed; Claude over MCP replaced it. Set these only
# if you deliberately run that stack.
#
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# MCP_URL=http://localhost:8080/mcp
# START_GO_SERVER=true
# CACHE_REFRESH_ON_START=true
# CACHE_REFRESH_DAILY=true
# CACHE_REFRESH_TIME=19:00
# CACHE_REFRESH_FAST=true
# REPO_ROOT=/path/to/fpl-draft-mcp
# REPORTS_DIR=reports
# REPORTS_TZ=America/New_York
